---
import type { Credit } from '../lib';
interface Props { credits: Credit[] }
const { credits } = Astro.props;
const host = (url: string) => (url.includes('github.com') ? 'Xem repo GitHub' : 'Xem trang gốc');
---
<section class="credits">
  <div class="label">Mã nguồn và tài nguyên gốc</div>
  <p class="intro">Module này dựng trên các dự án dưới đây. Cảm ơn các tác giả. Khi chia sẻ lại, giữ giấy phép và tên tác giả gốc.</p>
  <ul>
    {credits.map(c => (
      <li>
        <div class="info">
          <strong>{c.name}</strong>
          <span class="meta">{c.by} · {c.license}</span>
          <span class="use">{c.use}</span>
        </div>
        <a class="btn sm" href={c.url} target="_blank" rel="noopener">{host(c.url)} ↗</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .credits{margin-top:72px;border-top:1px solid var(--ink);padding-top:20px;max-width:760px}
  .intro{margin:12px 0 0;font-size:14px;line-height:1.55;color:var(--ink2)}
  ul{list-style:none;margin:12px 0 0;padding:0}
  li{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid var(--line);flex-wrap:wrap}
  .info{display:grid;gap:3px;min-width:0;flex:1 1 260px}
  .info strong{font-size:16px}
  .meta{font-family:var(--mono);font-size:11px;color:var(--mute)}
  .use{font-size:14px;color:var(--ink2);line-height:1.45}
  .btn{flex:none}
</style>
