---
import { donate, hasPublic, u } from '../lib';
const show = hasPublic(donate.qr);
---
{show && (
  <div class="dn" id="dn">
    <button class="dn-btn" type="button" aria-expanded="false" aria-controls="dn-card">
      <span class="dn-cup" aria-hidden="true">☕</span>
      <span class="dn-txt">Ủng hộ mình ly cà phê</span>
    </button>
    <div class="dn-card" id="dn-card" role="dialog" aria-label="Ủng hộ mình ly cà phê" hidden>
      <button class="dn-x" type="button" aria-label="Đóng">×</button>
      <p class="dn-h">Mời Duy ly cà phê ☕</p>
      <p class="dn-p">Thấy module hữu ích thì ủng hộ mình chút đỉnh để duy trì gói Claude nha. Quét bằng app ngân hàng bất kỳ.</p>
      <img src={u(donate.qr)} alt="Mã QR chuyển khoản ủng hộ" width="240" height="240" loading="lazy" />
      {(donate.bank || donate.account) && (
        <dl class="dn-info">
          {donate.bank && <><dt>Ngân hàng</dt><dd>{donate.bank}</dd></>}
          {donate.account && <><dt>Số TK</dt><dd><code>{donate.account}</code> <button class="dn-copy" type="button" data-acc={donate.account}>Chép</button></dd></>}
          {donate.name && <><dt>Chủ TK</dt><dd>{donate.name}</dd></>}
        </dl>
      )}
      <p class="dn-thx">Cảm ơn bạn nhiều!</p>
    </div>
  </div>
)}

<script>
  const dn = document.getElementById('dn');
  if (dn) {
    const btn = dn.querySelector<HTMLButtonElement>('.dn-btn')!;
    const card = dn.querySelector<HTMLElement>('.dn-card')!;
    const set = (open: boolean) => { card.hidden = !open; btn.setAttribute('aria-expanded', String(open)); };
    btn.addEventListener('click', () => set(card.hidden));
    dn.querySelector('.dn-x')!.addEventListener('click', () => set(false));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') set(false); });
    document.addEventListener('click', e => { if (!dn.contains(e.target as Node)) set(false); });
    dn.querySelector<HTMLButtonElement>('.dn-copy')?.addEventListener('click', async ev => {
      const b = ev.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(b.dataset.acc || ''); b.textContent = 'Đã chép'; } catch { b.textContent = 'Chép tay nhé'; }
      setTimeout(() => (b.textContent = 'Chép'), 1500);
    });
    // Hiện cùng lúc với cụm Follow bên phải
    const onScroll = () => dn.classList.toggle('show', window.scrollY > Math.min(520, window.innerHeight * 0.6));
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .dn{position:fixed;left:max(16px,env(safe-area-inset-left));bottom:max(16px,env(safe-area-inset-bottom));z-index:50;
    opacity:0;transform:translateY(16px);pointer-events:none;transition:opacity .25s ease,transform .25s ease}
  .dn.show{opacity:1;transform:none;pointer-events:auto}
  .dn-btn{display:flex;align-items:center;gap:10px;font:500 14px/1 var(--sans);color:var(--ink);background:var(--bg);border:1.5px solid var(--ink);border-radius:999px;padding:8px 16px 8px 8px;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.16);transition:background .15s ease,color .15s ease,transform .15s ease}
  .dn-cup{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--accent);font-size:20px}
  .dn-btn:hover,.dn-btn[aria-expanded="true"]{background:var(--ink);color:var(--bg)}
  .dn-btn:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .dn-card{position:absolute;left:0;bottom:calc(100% + 12px);width:min(300px,calc(100vw - 32px));background:var(--bg);border:1.5px solid var(--ink);border-radius:6px;padding:20px;box-shadow:0 12px 32px rgba(0,0,0,.2);text-align:center;max-height:calc(100vh - 100px);overflow-y:auto}
  .dn-x{position:absolute;top:6px;right:8px;width:32px;height:32px;border:0;background:none;font-size:22px;line-height:1;color:var(--mute);cursor:pointer}
  .dn-x:hover{color:var(--ink)}
  .dn-h{font-family:var(--serif);font-weight:600;font-size:20px;margin:0 0 8px}
  .dn-p{font-size:14px;line-height:1.5;color:var(--ink2);margin:0 0 14px;text-wrap:pretty}
  .dn-card img{display:block;width:100%;max-width:240px;height:auto;margin:0 auto;border:1px solid var(--line);border-radius:4px;background:#fff}
  .dn-info{display:grid;grid-template-columns:auto 1fr;gap:6px 12px;margin:14px 0 0;text-align:left;font-size:14px}
  .dn-info dt{color:var(--mute)} .dn-info dd{margin:0;overflow-wrap:anywhere}
  .dn-info code{font-family:var(--mono);color:var(--accent)}
  .dn-copy{font:11px var(--mono);border:1px solid var(--line2);background:var(--bg);border-radius:4px;padding:2px 6px;cursor:pointer;margin-left:4px}
  .dn-thx{margin:14px 0 0;font-size:13px;color:var(--mute)}
  /* điện thoại: chỉ giữ cốc cho gọn */
  @media (max-width: 640px){
    .dn-txt{display:none}
    .dn-btn{padding:6px}
  }
  @media (prefers-reduced-motion: reduce){.dn,.dn-btn{transition:none}}
</style>
