---
import { donate, hasPublic, u } from '../lib';
const show = hasPublic(donate.qr);
---
{show && (
  <aside class="dq" aria-label="Ủng hộ mình ly cà phê">
    <p class="dq-h">Ủng hộ mình ly cà phê ☕</p>
    <img src={u(donate.qr)} alt="Mã QR chuyển khoản ủng hộ (TPBank)" width="180" height="180" loading="lazy" />
    <p class="dq-acc">{donate.bank}<br />{donate.account}</p>
  </aside>
)}

<style>
  /* Chỉ hiện ở màn hình đủ rộng, nằm gọn trong lề trái, không đè lên nội dung (.wrap rộng 1200px).
     Màn hình hẹp hơn: QR nằm trong phần Liên hệ. */
  .dq{display:none}
  @media (min-width:1440px){
    .dq{display:block;position:fixed;z-index:40;left:16px;bottom:max(32px,env(safe-area-inset-bottom));
      width:min(180px,calc((100vw - 1200px) / 2 - 8px));padding:8px;background:var(--bg);border:1.5px solid var(--ink);border-radius:6px;box-shadow:0 6px 18px rgba(0,0,0,.12);text-align:center}
    .dq-h{margin:2px 0 8px;font:600 12px/1.3 var(--sans);color:var(--ink)}
    .dq img{display:block;width:100%;height:auto;border-radius:3px;background:#fff}
    .dq-acc{margin:6px 0 0;font:500 10.5px/1.4 var(--mono);color:var(--ink2);overflow-wrap:anywhere}
  }
</style>
