---
import { social, socialIcons, socialName, zalo, donate, hasPublic, u } from '../lib';
const showZalo = !!zalo.link;
const zaloQr = hasPublic(zalo.qr);
const showDonate = hasPublic(donate.qr);
---
{social.length > 0 && (
  <nav class="fab" id="fab" aria-label="Theo dõi Claude with Duy">
    <span class="fab-title">Follow</span>
    <ul class="fab-list">
      {social.map(([k, href]) => (
        <li>
          <a href={href} target="_blank" rel="noopener" aria-label={socialName[k] ?? k}>
            <span class="fab-name">{socialName[k] ?? k}</span>
            <span class="fab-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={socialIcons[k]} /></svg></span>
          </a>
        </li>
      ))}
    </ul>
    {showZalo && (
      <>
        <hr class="fab-hr" />
        <div class="fab-x">
          <a href={zalo.link} target="_blank" rel="noopener" aria-label="Nhóm Zalo hỗ trợ">
            <span class="fab-name">Hỗ trợ</span>
            <span class="fab-ico zl-ico">
              <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
                <defs><mask id="zl-m"><rect width="24" height="24" fill="#fff" /><text x="12" y="13.3" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="6.6" fill="#000">Zalo</text></mask></defs>
                <path fill="currentColor" mask="url(#zl-m)" d="M6 3h12a4 4 0 0 1 4 4v7a4 4 0 0 1-4 4h-7.5L6 21.5V18a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z" />
              </svg>
            </span>
          </a>
          {zaloQr && (
            <div class="fab-pop" aria-hidden="true">
              <img src={u(zalo.qr)} alt="" width="160" height="160" loading="lazy" />
              <span>Quét bằng Zalo để vào nhóm hỗ trợ</span>
            </div>
          )}
        </div>
      </>
    )}
    {showDonate && (
      <div class="fab-x fab-dn" id="fab-dn">
        <button type="button" aria-expanded="false" aria-controls="fab-dn-pop" aria-label="Ủng hộ mình ly cà phê">
          <span class="fab-name">Ủng hộ ☕</span>
          <span class="fab-ico">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 10h12v4.5A5.5 5.5 0 0 1 10.5 20h-1A5.5 5.5 0 0 1 4 14.5V10z" />
              <path d="M16 11.5h1.5a2.5 2.5 0 0 1 0 5H15.6" />
              <path d="M8 3.5c-.6.8.6 1.7 0 2.5M11.5 3.5c-.6.8.6 1.7 0 2.5" />
            </svg>
          </span>
        </button>
        <div class="fab-pop" id="fab-dn-pop">
          <p class="fab-pop-h">Ủng hộ mình ly cà phê ☕</p>
          <img src={u(donate.qr)} alt="Mã QR chuyển khoản ủng hộ (TPBank)" width="160" height="160" loading="lazy" />
          <span>{donate.bank} · <b>{donate.account}</b><br />{donate.name}</span>
          <button type="button" class="fab-copy" data-acc={donate.account}>Chép số TK</button>
        </div>
      </div>
    )}
  </nav>
)}

<script>
  // Nút Ủng hộ: chạm/bấm để mở QR (điện thoại không có hover), bấm ra ngoài hoặc Esc để đóng
  const dn = document.getElementById('fab-dn');
  if (dn) {
    const btn = dn.querySelector<HTMLButtonElement>(':scope > button')!;
    const set = (open: boolean) => { dn.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open)); };
    btn.addEventListener('click', () => set(!dn.classList.contains('open')));
    document.addEventListener('click', e => { if (!dn.contains(e.target as Node)) set(false); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') set(false); });
    dn.querySelector<HTMLButtonElement>('.fab-copy')?.addEventListener('click', async ev => {
      const b = ev.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(b.dataset.acc || ''); b.textContent = 'Đã chép'; } catch { b.textContent = 'Chép tay nhé'; }
      setTimeout(() => (b.textContent = 'Chép số TK'), 1500);
    });
  }
</script>

<style>
  .fab{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(32px,env(safe-area-inset-bottom));z-index:50;display:flex;flex-direction:column;align-items:flex-end;gap:10px}
  .fab-title{font:500 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--bg);background:var(--ink);padding:6px 10px;border-radius:999px}
  .fab-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;align-items:flex-end;gap:10px}
  .fab-list a{display:flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none}
  .fab-name{display:none;font:500 14px/1 var(--sans);background:var(--bg);border:1px solid var(--line2);padding:8px 12px;border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,.08);white-space:nowrap}
  .fab-ico{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:var(--bg);border:1.5px solid var(--ink);box-shadow:0 6px 18px rgba(0,0,0,.16);transition:background .15s ease,color .15s ease,transform .15s ease}
  .fab-list a:hover .fab-ico{background:var(--ink);color:var(--bg);transform:scale(1.06)}
  .fab-list a:focus-visible{outline:none}
  .fab-list a:focus-visible .fab-ico{outline:2px solid var(--accent);outline-offset:3px}
  /* vạch ngăn + nút Zalo hỗ trợ */
  .fab-hr{width:32px;margin:2px 8px 2px 0;border:0;border-top:1.5px solid var(--line2)}
  .fab-x{position:relative}
  .fab-x>a,.fab-x>button{display:flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none;background:none;border:0;padding:0;font:inherit;cursor:pointer}
  .fab-x>a:hover .fab-ico,.fab-x>button:hover .fab-ico,.fab-dn.open .fab-ico{background:var(--ink);color:var(--bg);transform:scale(1.06)}
  .fab-x>a:focus-visible,.fab-x>button:focus-visible{outline:none}
  .fab-x>a:focus-visible .fab-ico,.fab-x>button:focus-visible .fab-ico{outline:2px solid var(--accent);outline-offset:3px}
  .fab-pop{position:absolute;right:72px;bottom:0;width:196px;padding:10px;background:var(--bg);border:1.5px solid var(--ink);border-radius:6px;box-shadow:0 12px 32px rgba(0,0,0,.18);text-align:center;
    opacity:0;visibility:hidden;transform:translateX(6px);transition:opacity .18s ease,transform .18s ease,visibility .18s}
  .fab-pop img{display:block;width:100%;height:auto;border-radius:3px;background:#fff}
  .fab-pop span{display:block;margin-top:8px;font:500 12px/1.4 var(--sans);color:var(--ink2)}
  .fab-pop b{font-family:var(--mono);font-weight:500;color:var(--accent)}
  .fab-pop-h{margin:2px 0 8px;font:600 13px/1.3 var(--sans);color:var(--ink)}
  .fab-copy{margin-top:8px;font:11px var(--mono);border:1px solid var(--line2);background:var(--bg);border-radius:4px;padding:4px 8px;cursor:pointer;color:var(--ink)}
  .fab-copy:hover{border-color:var(--ink)}
  @media (hover:hover){.fab-x:hover .fab-pop,.fab-x:focus-within .fab-pop{opacity:1;visibility:visible;transform:none}}
  .fab-dn.open .fab-pop{opacity:1;visibility:visible;transform:none}
  /* màn hình rộng: QR ủng hộ đã nằm sẵn ở lề trái (DonateQR) */
  @media (min-width:1440px){.fab-dn{display:none}}
  .fab-ico svg{width:22px;height:22px}
  .fab-pop{right:60px}
  /* Lề phải hẹp: chỉ icon, nhãn chữ hiện khi rê chuột (không đè nội dung) */
  @media (hover:hover){.fab-list a:hover .fab-name,.fab-x>a:hover .fab-name,.fab-x>button:hover .fab-name{display:block}}
  /* lề đủ rộng cho icon lớn */
  @media (min-width:1440px){
    .fab-ico{width:60px;height:60px}
    .fab-ico svg{width:26px;height:26px}
    .fab-pop{right:72px}
  }
  /* lề đủ rộng cho cả nhãn chữ: hiện sẵn */
  @media (min-width:1640px){.fab-name{display:block}}
  @media (prefers-reduced-motion: reduce){.fab-ico,.fab-pop{transition:none}}
</style>
