---
import '../styles/global.css';
import { u } from '../lib';
import SocialFab from '../components/SocialFab.astro';
import DonateFab from '../components/DonateFab.astro';
interface Props { title: string; description: string; current?: 'module' | 'template' | 'install'; image?: string }
const { title, description, current, image } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image && Astro.site ? new URL(u(image), Astro.site).href : undefined;
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {canonical && <link rel="canonical" href={canonical} />}
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Anton&family=Be+Vietnam+Pro:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap&subset=vietnamese" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="brand" href={u('')}><img src={u('logo.svg')} alt="" width="28" height="28" />CLAUDE WITH DUY</a>
      <nav>
        <a href={u('#module')} aria-current={current === 'module' ? 'page' : undefined}>Module</a>
        <a href={u('template/')} aria-current={current === 'template' ? 'page' : undefined}>Style</a>
        <a href={u('#cach-cai')} aria-current={current === 'install' ? 'page' : undefined}>Cách cài</a>
        <a href={u('#cau-hinh')}>Cấu hình</a>
        <a href={u('#faq')}>FAQ</a>
        <a href={u('#lien-he')}>Liên hệ</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <SocialFab />
  <DonateFab />
  <footer class="foot"><div class="wrap"><span>Claude with Duy</span><slot name="foot" /></div></footer>
  <script>
    // Hiện dần khi cuộn tới
    const els = document.querySelectorAll('[data-r]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.08 });
      els.forEach(e => io.observe(e));
    } else els.forEach(e => e.classList.add('in'));
    setTimeout(() => els.forEach(e => e.classList.add('in')), 4000);

    // Mọi demo tự phát (tắt tiếng) khi vào màn hình, dừng khi ra khỏi màn hình.
    const vidsOf = (box: Element) => box.querySelectorAll('video');
    const play = (box: Element) => vidsOf(box).forEach(v => v.play().catch(() => {}));
    const stop = (box: Element) => vidsOf(box).forEach(v => v.pause());
    const boxes = document.querySelectorAll<HTMLElement>('[data-demo]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(es => es.forEach(e => (e.isIntersecting ? play(e.target) : stop(e.target))), { threshold: 0.35 });
      boxes.forEach(b => io.observe(b));
    } else boxes.forEach(play);

    // Nút loa: bật tiếng clip này, tắt tiếng mọi clip khác. Clip đang có tiếng chạy lại từ đầu cho dễ nghe.
    const sndBtns = document.querySelectorAll<HTMLButtonElement>('[data-snd]');
    const setBtn = (b: HTMLButtonElement, on: boolean) => { b.setAttribute('aria-pressed', String(on)); b.setAttribute('aria-label', on ? 'Tắt âm thanh' : 'Bật âm thanh'); };
    sndBtns.forEach(b => b.addEventListener('click', () => {
      const v = b.parentElement?.querySelector<HTMLVideoElement>('video[data-audio]');
      if (!v) return;
      const on = v.muted;
      document.querySelectorAll<HTMLVideoElement>('video[data-audio]').forEach(o => { if (o !== v) o.muted = true; });
      sndBtns.forEach(o => o !== b && setBtn(o, false));
      v.muted = !on;
      // chạy lại cả cặp TRƯỚC/SAU cùng lúc để nghe so sánh khớp nhau
      if (on) (v.closest('[data-demo]')?.querySelectorAll('video') ?? [v]).forEach(o => { o.currentTime = 0; o.play().catch(() => {}); });
      setBtn(b, on);
    }));
    // ra khỏi màn hình thì tự tắt tiếng
    if ('IntersectionObserver' in window) {
      const mo = new IntersectionObserver(es => es.forEach(e => {
        if (e.isIntersecting) return;
        const v = e.target as HTMLVideoElement;
        if (!v.muted) { v.muted = true; const b = v.parentElement?.querySelector<HTMLButtonElement>('[data-snd]'); if (b) setBtn(b, false); }
      }), { threshold: 0 });
      document.querySelectorAll('video[data-audio]').forEach(v => mo.observe(v));
    }

    // Nút chép lệnh
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(b => b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy || ''); b.textContent = 'Đã chép'; }
      catch { b.textContent = 'Chép tay nhé'; }
      setTimeout(() => (b.textContent = 'Chép'), 1500);
    }));
  </script>
</body>
</html>
