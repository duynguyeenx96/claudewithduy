---
import Base from '../layouts/Base.astro';
import { u } from '../lib';
---
<Base title="Không tìm thấy trang: Claude with Duy" description="Trang này không tồn tại.">
  <section class="wrap" style="padding:120px 24px 160px">
    <div class="label" style="margin-bottom:16px">404</div>
    <h1 class="h1" style="font-size:clamp(36px,5vw,60px)">Không có trang này.</h1>
    <p class="lead" style="margin:0 0 32px">Link có thể đã đổi.</p>
    <a class="btn solid" href={u('#module')}>Về trang chủ</a>
  </section>
</Base>
