---
import Base from '../layouts/Base.astro';
import Cmd from '../components/Cmd.astro';
import SoundBtn from '../components/SoundBtn.astro';
import { fxFree, fxPro, u, pad, pluginInstall, marketplaceAdd } from '../lib';
const total = fxFree.length + fxPro.length;
const nFx = fxFree.reduce((a, m) => a + (m.effects?.length ?? 0), 0);
---
<Base title="FX Pack: Claude with Duy" description={`Các gói hiệu ứng cho video người nói: ${fxFree.length} gói miễn phí (${nFx} hiệu ứng) và các gói đang làm.`} current="fx" image="og.jpg">
  <div class="wrap" style="padding-top:72px;padding-bottom:24px">
    <div class="label" style="margin-bottom:16px">FX Pack</div>
    <h1 class="h1" style="font-size:clamp(36px,5vw,60px);margin:0 0 20px">Gói hiệu ứng</h1>
    <p class="lead" style="margin:0;max-width:720px">Hiệu ứng cho video người nói, bám theo mặt, chữ và ảnh chui được ra sau đầu. Cài từng gói, gọi bằng <code class="inl">/effects</code> trong Claude Code.</p>
  </div>
  <div class="wrap layout">
    <aside>
      <div class="label" style="font-size:11px;padding:16px 0 8px">Loại</div>
      <button type="button" class="t on" data-t="all"><span>Tất cả</span><span class="n">{pad(total)}</span></button>
      <button type="button" class="t" data-t="free"><span>Miễn phí</span><span class="n">{pad(fxFree.length)}</span></button>
      <button type="button" class="t" data-t="pro"><span>Bán sau</span><span class="n">{pad(fxPro.length)}</span></button>
      <div class="side-cmd">
        <div class="label" style="font-size:11px;margin-bottom:8px">Thêm marketplace (một lần)</div>
        <Cmd text={marketplaceAdd} />
      </div>
    </aside>
    <div style="flex:1 1 320px;min-width:0">
      <div class="bar"><h2 id="tt">Tất cả</h2><span class="label" id="tn">{total} gói</span></div>
      <div class="grid">
        {fxFree.map(m => (
          <article data-kind="free">
            <div class="vframe dark card" data-demo>
              <video src={u(m.video.main!)} muted loop playsinline preload="metadata" data-audio=""></video>
              <SoundBtn />
              <span class="mark free">Miễn phí</span>
            </div>
            <div class="label" style="font-size:11px">{m.effects?.length} hiệu ứng</div>
            <h3><a href={u(`module/${m.id}/`)}>{m.name}</a></h3>
            <p class="desc">{m.desc}</p>
            <Cmd text={pluginInstall(m.skill!.plugin!)} />
            <a class="more" href={u(`module/${m.id}/#hieu-ung`)}>Xem {m.effects?.length} hiệu ứng →</a>
          </article>
        ))}
        {fxPro.map(p => (
          <article data-kind="pro">
            <div class="vframe card pro-card">
              <span class="label empty">Đang quay</span>
              <span class="mark pro">Bán sau</span>
            </div>
            <div class="label" style="font-size:11px">{p.count}</div>
            <h3>{p.name}</h3>
            <p class="desc">{p.desc}</p>
            <p class="note">Đang quay và chỉnh. Gói này sẽ bán, chưa định ngày.</p>
          </article>
        ))}
      </div>
    </div>
  </div>
  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('.t');
    const cards = document.querySelectorAll<HTMLElement>('article[data-kind]');
    const names: Record<string, string> = { all: 'Tất cả', free: 'Miễn phí', pro: 'Bán sau' };
    function pick(t: string) {
      let n = 0;
      cards.forEach(c => { const ok = t === 'all' || c.dataset.kind === t; c.hidden = !ok; if (ok) n++; });
      btns.forEach(b => b.classList.toggle('on', b.dataset.t === t));
      document.getElementById('tt')!.textContent = names[t];
      document.getElementById('tn')!.textContent = n + ' gói';
    }
    btns.forEach(b => b.addEventListener('click', () => { pick(b.dataset.t!); try { history.replaceState(null, '', b.dataset.t === 'all' ? location.pathname : '?loai=' + b.dataset.t); } catch {} }));
    const q = new URLSearchParams(location.search).get('loai');
    if (q && names[q]) pick(q);
  </script>
  <style>
    .layout{padding-top:32px;padding-bottom:112px;display:flex;flex-wrap:wrap;gap:40px 56px;align-items:flex-start}
    aside{flex:0 0 240px;position:sticky;top:90px;border-top:1px solid var(--ink);min-width:min(240px,100%)}
    @media (max-width:700px){aside{position:static;flex-basis:100%}}
    .t{all:unset;box-sizing:border-box;width:100%;cursor:pointer;display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);font-size:16px}
    .t .n{font-family:var(--mono);font-size:12px;color:var(--mute)}
    .t.on,.t.on .n{color:var(--accent);font-weight:600}
    .t:focus-visible{outline:2px solid var(--accent)}
    .side-cmd{margin-top:28px;min-width:0}
    .bar{display:flex;justify-content:space-between;align-items:baseline;gap:12px;border-top:1px solid var(--ink);padding:16px 0 24px;flex-wrap:wrap}
    .bar h2{font-family:var(--serif);font-weight:600;font-size:26px;margin:0}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(340px,100%),1fr));gap:40px 28px}
    article{display:flex;flex-direction:column;gap:12px;min-width:0}
    .card{aspect-ratio:16/9;border-radius:4px;position:relative;display:flex;align-items:center;justify-content:center}
    .pro-card{background:var(--bg2);border:1px dashed var(--line)}
    .empty{font-size:11px}
    article h3{font-family:var(--serif);font-weight:600;font-size:21px;line-height:1.2;margin:-6px 0 0}
    article h3 a{color:inherit;text-decoration:none}
    article h3 a:hover{color:var(--accent)}
    .desc{margin:-4px 0 0;font-size:14px;line-height:1.5;color:var(--ink2)}
    .note{margin:0;font-size:13px;color:var(--mute)}
    .more{font-size:14px}
    .mark{position:absolute;top:10px;left:10px;font-family:var(--mono);font-size:11px;letter-spacing:.04em;text-transform:uppercase;padding:3px 8px;border-radius:3px;z-index:2}
    .mark.free{background:var(--accent);color:#fff}
    .mark.pro{background:var(--ink);color:var(--bg)}
    .inl{font-family:var(--mono);font-size:13px;color:var(--accent);background:var(--bg2);padding:1px 6px;border-radius:3px}
  </style>
</Base>
