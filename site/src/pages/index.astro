---
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Feature from '../components/Feature.astro';
import Cmd from '../components/Cmd.astro';
import { requirements as rq, modules, flow, site, u, pad, kinds, marketplaceAdd, pluginInstall, repoUrl, social, socialIcons as icons } from '../lib';

const ready = modules.filter(m => m.status === 'ready').length;
const firstPlugin = modules.find(m => m.skill?.plugin)?.skill?.plugin ?? 'fx-pack';
---
<Base title="Claude with Duy: skill và tool dựng video cho Claude Code" description="Skill cho Claude Code và tool chạy local để dựng video. Cài bằng một lệnh." image="og.jpg">

<section id="top" class="wrap hero">
  <div data-r>
    <div class="label" style="margin-bottom:28px">Claude with Duy / {pad(modules.length)} module, {pad(ready)} dùng được ngay</div>
    <h1 class="h1">Nói với <span class="accent">Claude</span> bạn muốn làm video như thế nào!</h1>
    <p class="lead" style="margin:0 0 40px">Skill cho Claude Code và tool chạy local, tách ra từ flow dựng video mình dùng hằng ngày.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <a class="btn solid" href="#module">Xem các module</a>
      <a class="btn" href="#cach-cai">Cách cài</a>
    </div>
  </div>
  <div data-r style="display:flex;justify-content:center">
    <div class="phone" data-demo>
      <div class="vframe" style="width:100%;height:100%">
        <video src={u('videos/modules/fx-pack-hero.mp4')} muted loop playsinline autoplay preload="metadata"></video>
      </div>
    </div>
  </div>
</section>

<section class="band" style="border-bottom:1px solid var(--line)">
  <div class="wrap pad-s">
    <div class="label" data-r>01 / Flow</div>
    <h2 class="h2" data-r>Từ clip thô tới lúc đăng</h2>
    <ol class="flow" data-r>
      {flow.map((t, i) => <li style={i === flow.length - 1 ? 'border-top-color:var(--accent)' : ''}><span class="label">{pad(i + 1)}</span><span class="t">{t}</span></li>)}
    </ol>
  </div>
</section>

<section id="module" class="wrap" style="padding-top:104px">
  <div class="label" data-r>02 / Module</div>
  <h2 class="h2" data-r>Lấy cái nào cũng được</h2>
  <div class="filter">
    <span class="label" style="font-size:11px">Dạng</span>
    <div class="chips" role="group" aria-label="Lọc theo dạng">
      <button type="button" class="f on" data-f="all">Tất cả</button>
      <button type="button" class="f" data-f="skill">Skill</button>
      <button type="button" class="f" data-f="tool">Tool</button>
    </div>
    <span class="label" style="margin-left:auto;font-size:12px" id="count">{modules.length} module</span>
  </div>
  <div>
    {modules.map((m, i) => (
      <article class="mod" data-kinds={kinds(m)} data-r>
        <div class="mod-grid" style={i % 2 ? 'direction:rtl' : ''}>
          <div class="mod-info">
            <div class="num">{pad(i + 1)}</div>
            <div>
              <h3><a href={u(`module/${m.id}/`)}>{m.name}</a>{m.status !== 'ready' && <span class="chip sm soon">Sắp có</span>}</h3>
              <p class="desc">{m.desc}</p>
              <div class="chips">{m.chips.map((c, k) => k === 0 && m.effects ? <a class="chip chip-link" href={u(`module/${m.id}/#hieu-ung`)}>{c} →</a> : <span class="chip">{c}</span>)}</div>
              <Blocks m={m} />
              <p style="margin:16px 0 0;font-size:14px"><a href={u(`module/${m.id}/`)}>Chi tiết →</a></p>
            </div>
          </div>
          <div style="direction:ltr;align-self:stretch">
            {(m.video as any).main
              ? <Feature src={(m.video as any).main} audio={!!(m.video as any).audio} />
              : m.video.before || m.video.after
              ? <BeforeAfter before={m.video.before} after={m.video.after} audio={(m.video as any).audio} />
              : <div class="vframe novid"><span class="label">Chưa có video</span></div>}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<section id="cach-cai" class="wrap pad">
  <div class="label" data-r>03 / Cách cài</div>
  <h2 class="h2" data-r>Cách cài 1 module</h2>
  <div class="two" style="align-items:start">
    <div data-r>
      <h3 class="sub">Skill: hai lệnh trong Claude Code</h3>
      <p class="p">Thêm marketplace một lần, sau đó cài module nào cũng được.</p>
      <div style="display:grid;gap:8px;margin:20px 0">
        <Cmd text={marketplaceAdd} />
        <Cmd text={pluginInstall(firstPlugin)} />
      </div>
      <div class="term">
        <div class="bar">skill / Claude Code</div>
        <pre><span>$ claude</span>
<span class="c">&gt; {marketplaceAdd}</span>
<span class="c">&gt; {pluginInstall('fx-pack')}</span>
<span class="c">&gt; thêm hiệu ứng orbit vào video.mp4 giây 3 tới 6</span>
<span class="m">Đang dò mặt và tách người...</span>
<span class="m">Đã xuất khung kiểm, đang render...</span>
<span class="c">Xong: video_effects.mp4</span></pre>
      </div>
    </div>
    <div data-r>
      <h3 class="sub">Tool: tải về, bấm đúp</h3>
      <ol class="steps light">
        <li><span>01</span><div>Tải .zip, giải nén.</div></li>
        <li><span>02</span><div>Cài Python, FFmpeg hoặc Node.js nếu module cần.</div></li>
        <li><span>03</span><div>macOS: bấm đúp file <code class="inl">.command</code> (lần đầu chuột phải, chọn Mở). Windows: bấm đúp <code class="inl">start.bat</code>. Linux: <code class="inl">bash start.sh</code>.</div></li>
        <li><span>04</span><div>Kéo file vào trang vừa mở.</div></li>
      </ol>
    </div>
  </div>
</section>

<section id="cau-hinh" class="band">
  <div class="wrap pad">
    <div class="label" data-r>04 / Cấu hình</div>
    <h2 class="h2" data-r>Cần gì để chạy</h2>
    <h3 class="sub" data-r>Gói đăng ký</h3>
    <div class="rq-plans" data-r>
      {rq.plans.map(p => <div><div class="label" style="font-size:11px">{p.need}</div><h4>{p.name}</h4><p>{p.for}</p></div>)}
    </div>
    <p class="p rq-note" data-r>{rq.plans_note}</p>
    <div class="two" style="margin-top:64px;align-items:start" data-r>
      <div>
        <h3 class="sub">Máy tối thiểu</h3>
        <ul class="rq-list">{rq.machine.min.map(x => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h3 class="sub">Máy đề nghị</h3>
        <ul class="rq-list acc">{rq.machine.rec.map(x => <li>{x}</li>)}</ul>
      </div>
    </div>
    <p class="p rq-note" data-r>{rq.machine.note}</p>
    <h3 class="sub" style="margin-top:64px" data-r>Phần mềm</h3>
    <p class="p" style="margin-bottom:20px" data-r>Bốn thứ dùng chung. Phần mềm riêng (whisper-cpp, yt-dlp, CapCut, ZeroTTS…) ghi ở mục Yêu cầu của từng module.</p>
    <div class="rq-table" data-r>
      {rq.software.map(s => <div><b>{s.name}</b><span>{s.for}</span><code class="inl">{s.install}</code></div>)}
    </div>
  </div>
</section>

<section id="faq" class="band">
  <div class="wrap pad">
    <div class="label" data-r>05 / FAQ</div>
    <h2 class="h2" data-r>Hay hỏi</h2>
    <div class="faq" data-r>
      <div><h3>Skill và Tool khác nhau thế nào?</h3><p>Skill là plugin cho Claude Code. Tool là trang kéo thả chạy local, không cần Claude.</p></div>
      <div><h3>Chạy trên Windows, Linux được không?</h3><p>Được, cả skill lẫn tool. Riêng CapCut Auto-Edit chỉ chạy trên macOS.</p></div>
      <div><h3>Cập nhật thế nào?</h3><p>Skill: gõ <code class="inl">/plugin update</code> trong Claude Code. Tool: tải lại file .zip mới.</p></div>
      <div><h3>Mã nguồn ở đâu?</h3><p>Trên <a href={repoUrl} target="_blank" rel="noopener" style="text-decoration:underline">GitHub</a>.</p></div>
    </div>
  </div>
</section>

<section id="lien-he" class="village" style="border-bottom:0">
  <div class="wrap pad two">
    <div data-r>
      <div class="label">06 / Liên hệ</div>
      <h2 class="h2" style="margin-bottom:24px">Nhắn cho mình</h2>
      <p class="p" style="max-width:380px">Báo lỗi, góp ý hay cần module riêng: mở issue hoặc nhắn mình.</p>
    </div>
    <div data-r style="display:flex;flex-direction:column;gap:16px;align-items:flex-start;justify-content:center">
      <a class="btn solid" href={`${repoUrl}/issues/new`} target="_blank" rel="noopener">Mở issue trên GitHub</a>
      {social.length > 0 && (
        <div style="display:flex;gap:12px">
          {social.map(([k, href]) => (
            <a class="soc" href={href} target="_blank" rel="noopener" aria-label={k}><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d={icons[k]} /></svg></a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.f');
  const mods = document.querySelectorAll<HTMLElement>('.mod');
  const count = document.getElementById('count')!;
  function apply(f: string) {
    let n = 0;
    mods.forEach(m => { const ok = f === 'all' || (m.dataset.kinds || '').split(' ').includes(f); m.hidden = !ok; if (ok) n++; });
    mods.forEach(m => m.querySelectorAll<HTMLElement>('[data-kind]').forEach(b => (b.hidden = f !== 'all' && b.dataset.kind !== f)));
    btns.forEach(b => b.classList.toggle('on', b.dataset.f === f));
    count.textContent = n + ' module';
  }
  btns.forEach(b => b.addEventListener('click', () => { apply(b.dataset.f!); try { history.replaceState(null, '', '?type=' + b.dataset.f + '#module'); } catch {} }));
  const q = new URLSearchParams(location.search).get('type');
  if (q === 'skill' || q === 'tool') apply(q);
</script>

<style>
  .hero{padding-top:96px;padding-bottom:112px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:64px;align-items:center}
  .phone{width:min(270px,100%);aspect-ratio:9/16;border:1px solid var(--ink);border-radius:4px;padding:10px}
  .pad-s{padding-top:88px;padding-bottom:88px}
  .flow{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
  .flow li{padding:20px 16px 24px;border-left:1px solid var(--line);border-top:3px solid var(--ink);display:grid;gap:28px}
  .flow .t{font-family:var(--serif);font-size:22px;font-weight:500;line-height:1.2}
  .filter{position:sticky;top:57px;z-index:9;background:var(--bg);border-top:1px solid var(--ink);border-bottom:1px solid var(--line);padding:14px 0;display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center}
  .f{font:inherit;font-size:13px;cursor:pointer;padding:7px 12px;border:1px solid var(--ink);border-radius:4px;background:transparent;color:var(--ink)}
  .f.on{background:var(--ink);color:var(--bg)}
  .mod{border-bottom:1px solid var(--line);padding:40px 0}
  .mod-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:40px 56px}
  .mod-info{display:grid;grid-template-columns:56px 1fr;gap:0 8px;align-content:start;direction:ltr}
  @media (max-width:600px){.mod-info{grid-template-columns:1fr}.num{margin-bottom:12px}}
  .num{font-family:var(--display);font-size:32px;color:var(--accent);line-height:1}
  .mod h3{font-family:var(--serif);font-weight:600;font-size:28px;margin:0 0 12px;line-height:1.15;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
  .soon{font-family:var(--mono);font-weight:400}
  .desc{margin:0 0 20px;font-size:16px;line-height:1.6;color:var(--ink2);text-wrap:pretty}
  .novid{min-height:320px;height:100%;display:flex;align-items:center;justify-content:center}
  .village{background:var(--bg2);border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);margin-top:96px}
  #lien-he{margin-top:0}
  .two{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:56px}
  .two>*{min-width:0}
  .steps{list-style:none;margin:0;padding:0;border-top:1px solid var(--ink)}
  .steps li{display:grid;grid-template-columns:48px 1fr;padding:14px 0;border-bottom:1px solid var(--line2);font-size:16px;line-height:1.5}
  .steps li>span{font-family:var(--mono);font-size:13px;color:var(--accent);padding-top:2px}
  .sub{font-family:var(--serif);font-weight:500;font-size:24px;margin:0 0 12px}
  .p{font-size:16px;line-height:1.6;color:var(--ink2);margin:0}
  .inl{font-family:var(--mono);font-size:13px;color:var(--accent);background:var(--bg2);padding:1px 6px;border-radius:3px}
  .rq-plans{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:0;border-top:1px solid var(--ink)}
  .rq-plans>div{padding:20px 20px 24px 0;border-bottom:1px solid var(--line)}
  .rq-plans h4{font-family:var(--serif);font-weight:500;font-size:20px;margin:8px 0}
  .rq-plans p{margin:0;font-size:15px;line-height:1.55;color:var(--ink2)}
  .rq-note{margin-top:16px;font-size:14px;color:var(--mute)}
  .rq-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--ink)}
  .rq-list li{padding:12px 0;border-bottom:1px solid var(--line);font-size:16px;color:var(--ink2)}
  .rq-list.acc{border-top-color:var(--accent)}
  .rq-table{border-top:1px solid var(--ink)}
  .rq-table>div{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.4fr) minmax(0,1fr);gap:8px 24px;padding:14px 0;border-bottom:1px solid var(--line);align-items:baseline;font-size:15px}
  .rq-table span{color:var(--ink2)}
  .rq-table code{justify-self:start;overflow-wrap:anywhere}
  @media (max-width:700px){.rq-table>div{grid-template-columns:1fr}}
  .faq{border-top:1px solid var(--ink)}
  .faq>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:12px 56px;padding:28px 0;border-bottom:1px solid var(--line)}
  .faq h3{font-family:var(--serif);font-weight:500;font-size:22px;margin:0}
  .faq p{margin:0;font-size:16px;line-height:1.6;color:var(--ink2);text-wrap:pretty}
  .soc{width:48px;height:48px;border:1px solid var(--ink);border-radius:4px;display:flex;align-items:center;justify-content:center}
  .soc:hover{background:var(--ink);color:var(--bg)}
</style>
</Base>
