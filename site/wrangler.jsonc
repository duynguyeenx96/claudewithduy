// Cloudflare Workers. Build: npm ci && npm run build, deploy: npx wrangler deploy
// /api/* chạy worker/index.js (thanh toán SePay), còn lại là file tĩnh trong dist.
{
  "name": "ke-module",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "claudewithduy-shop", "database_id": "4658b351-0378-4e2b-82f4-6a5516fd6f49" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "claudewithduy-shop-files" }
  ],
  "vars": {
    "SALES_OPEN": "0",
    "DOWNLOADS_OPEN": "1",
    "SEPAY_ACC": "06516324401",
    "SEPAY_BANK": "TPBank",
    "SITE_URL": "https://claudewithduy.io.vn",
    "MAIL_FROM": "Duy · Claude with Duy <don@claudewithduy.io.vn>"
  }
  // Secret (wrangler secret put): SEPAY_WEBHOOK_KEY, RESEND_API_KEY, NOTIFY_EMAIL
}
